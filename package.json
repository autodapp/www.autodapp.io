  },
  "devDependencies": {
    "@commitlint/config-conventional": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "commitlint": "^8.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "husky": "^9.1.7",
    "lint-staged": "^9.2.1",
    "prettier": "^1.19.1",
    "serve": "^14.2.6",
