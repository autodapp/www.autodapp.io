{
  "name": "autodapp.io",
  "private": true,
  "description": "AutoDapp",
  "version": "1.0.0",
  "author": "Jeffrey Dash Hsu <jeff@thectozone.com>",
  "bugs": {
    "url": "https://github.com/autodapp/www.autodapp.io"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "commitlint": "^8.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "husky": "^3.0.3",
    "lint-staged": "^9.2.1",
    "prettier": "^1.19.1",
    "tailwindcss": "^4.3.3"
  },
  "homepage": "https://github.com/autodapp/www.autodapp.io#readme",
  "keywords": [
    "nextjs"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autodapp/www.autodapp.io.git"
  },
  "scripts": {
    "predev": "node scripts/copy-blog-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-blog-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "npm run prettier -- --write",
    "prettier": "prettier \"**/*.+(js|jsx|ts|tsx|json|yml|yaml|md|mdx)\"",
    "prettier:validate": "npm run prettier -- --list-different"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "**/*.+(js|jsx|ts|tsx|json|yml|yaml|md|mdx)": [
      "yarn format",
      "git add"
    ]
  }
}
